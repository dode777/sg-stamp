// SG스크린골프 방문 도장(카운터 직원용). 저장소를 연결해 두면 main 에 머지할 때마다 Workers Builds 가 배포한다.
// 데이터는 Durable Object 안의 SQLite 에 있다. 따로 만들 데이터베이스도, 넣을 비밀값도 없다(docs/DEPLOY.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sg-stamp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // 주소는 sg.isocompany.co.kr 하나다. 배포할 때 Cloudflare 가 DNS 와 인증서를 만든다(isocompany.co.kr 이 같은 계정에 있다)
  "workers_dev": false,
  "routes": [{ "pattern": "sg.isocompany.co.kr", "custom_domain": true }],

  // 화면 파일은 Cloudflare 가 바로 내주고 /api/* 만 Worker 가 받는다
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },

  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  // Durable Object 를 처음 만드는 기록. 이미 배포한 줄은 고치지 않고 새 tag 로 더한다
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],

  "observability": { "enabled": true }
}
